{
  "name": "papacrm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuke dev",
    "build": "npx @tailwindcss/cli -i ./global.css -o ./app/public/styles.css --minify && nuke build",
    "build:vercel": "npx @tailwindcss/cli -i ./global.css -o ./app/public/styles.css --minify && nuke build --vercel",
    "build:cloudflare": "npx @tailwindcss/cli -i ./global.css -o ./app/public/styles.css --minify && nuke build --cloudflare",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@kav3/jwt": "^1.0.6",
    "@orpc/client": "^1.14.15",
    "@orpc/server": "^1.14.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "lucide-react": "^0.462.0",
    "mongoose": "^9.9.1",
    "nukejs": "0.0.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "latest",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.2.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0"
  }
}
